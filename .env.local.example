# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Get this from https://resend.com/api-keys after creating a free account
RESEND_API_KEY=

# --- Request a Quote form (/quote) ---
# Where RFQs should land. Business Development / Sales inbox recommended.
QUOTE_TO_EMAIL=gabriel@blueliteconceptltd.com
# Optional: cc another address (e.g. Managing Director) on every RFQ
QUOTE_CC_EMAIL=kayode@blueliteconceptltd.com
# Optional. Once you've verified a domain in Resend, use an address on that
# domain, e.g. "Bluelite Concept LTD <quotes@blueliteconceptltd.com>".
# Leave blank to use Resend's shared test sender while testing.
QUOTE_FROM_EMAIL=

# --- General contact form (/contact) ---
CONTACT_TO_EMAIL=info@blueliteconceptltd.com
CONTACT_FROM_EMAIL=
